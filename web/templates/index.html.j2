{% extends 'base/layout.html.j2' %}
{% from 'base/screenshots.html.j2' import picture %}
{% from 'base/downloads.html.j2' import download %}
{% from 'macros.html.j2' import marker, cells, sensor_icon, stage_sensors, stage_listen, stage_shot %}
{% block content %}
{% set icon_down %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M6 11l6 6 6-6M4 21h16"/></svg>{% endset %}
<section id="about" class="hero">
<div class="wrap">
<div class="hero-grid">
<div class="hero-text">
<p class="mono">{{ c.eyebrow }}</p>
<h1 class="glitch">{{ c.headline }}</h1>
<p class="lede">{{ c.intro }}</p>
<p class="facts">{{ c.key_facts }}</p>
<div class="actions">
<a class="btn pri" href="#download">{{ icon_down }}{{ c.cta_download }}</a>
<a class="btn out" href="{{ site.repo_url }}">{{ c.cta_code }}</a>
</div>
</div>
{% set hero = shots[site.screenshots.index('03-ripple-live')] %}<figure class="vf">
<span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
<picture>
<source type="image/avif" srcset="{{ hero.avif }}" sizes="(max-width: 899px) 256px, 348px">
<source type="image/webp" srcset="{{ hero.webp }}" sizes="(max-width: 899px) 256px, 348px">
<img src="{{ hero.src }}" srcset="{{ hero.webp }}" sizes="(max-width: 899px) 256px, 348px" width="{{ hero.width }}" height="{{ hero.height }}" alt="{{ hero.alt }}" fetchpriority="high">
</picture>
</figure>
</div>
{% include 'base/loop_toggle.html.j2' %}
<ul class="readings" data-reveal="stagger" role="list" aria-label="{{ c.readings_label }}">
{% set lit = [12, 6, 12] %}{% set kinds = ['noise', 'light', 'move'] %}
{% for r in c.readings %}<li class="reading {{ kinds[loop.index0] }}">
<span class="row">{{ sensor_icon(kinds[loop.index0]) }}<span class="mono name">{{ r.name }}</span>{{ cells(lit[loop.index0]) }}</span>
<span class="text">{{ r.text }}</span>
</li>{% endfor %}
</ul>
</div>
</section>

<section id="download" class="sec">
<div class="wrap">
<div class="sec-head" data-reveal>{{ marker(2) }}<h2>{{ t.download }}</h2><p>{{ c.download_intro }}</p></div>
<div class="platforms" data-reveal="stagger">
{% for platform, kinds, note in [('android', ['apk', 'play'], c.android_note), ('ios', ['app_store', 'testflight'], c.ios_note)] %}
<div class="card platform">
<div class="card-head"><h3>{{ t[platform] }}</h3><span class="mono">{{ note }}</span></div>
{% if platform == 'android' %}<div class="store-row">{% endif %}
{% for item in site.downloads if item.kind in kinds %}
{% if item.kind == 'play' and item.state != 'soon' %}{{ download(item, t, lang) }}
{% elif item.state == 'soon' %}<div class="store soon"><span class="l">{{ t[item.kind] }}</span><span class="st">{{ t[item.state] }}</span></div>
{% else %}<a class="store" href="{{ item.url }}"><span class="l">{{ icon_down }}{{ t[item.kind] }}</span><span class="st">{{ t[item.state] }}</span></a>
{% endif %}
{% endfor %}
{% if platform == 'android' %}</div>{% endif %}
{% if platform == 'android' %}{% if site.closed_test is defined %}{% include 'base/closed_test.html.j2' %}<p class="sub">{{ c.closed_test_note }}</p>{% endif %}{% endif %}
{% if platform == 'ios' %}<p class="sub">{{ c.ios_text }}</p>{% endif %}
</div>
{% endfor %}
</div>
<p class="note">{{ c.apk_note }} <a href="#support">{{ c.apk_howto }}</a></p>
</div>
</section>

<section id="screenshots" class="sec">
<div class="wrap">
<div class="sec-head" data-reveal>{{ marker(4) }}<h2>{{ t.screenshots }}</h2><p class="mono hint">{{ c.shots_hint }}</p></div>
<div class="reel" data-reveal tabindex="0" role="region" aria-label="{{ t.screenshots }}">
<ul class="film" role="list">
{% for shot in shots %}{% set name = site.screenshots[loop.index0] %}<li><figure>{{ picture(shot, loop.first, "(max-width: 899px) 200px, 256px", enlarge=true, t=t) }}<figcaption class="mono"><span class="frm">{{ '%02d' | format(loop.index) }}</span><span>{{ c.screenshot_captions[name] }}</span></figcaption></figure></li>
{% endfor %}
</ul>
</div>
</div>
</section>

<section id="features" class="sec">
<div class="wrap">
<div class="sec-head" data-reveal>{{ marker(6) }}<h2>{{ t.features }}</h2><p>{{ c.features_intro }}</p></div>
<dl class="styles" data-reveal="stagger" role="group" aria-label="{{ c.styles_label }}">
{% for s in c.styles %}<div class="style"><dt>{{ s.name }}</dt><dd>{{ s.text }}</dd></div>{% endfor %}
</dl>
<ul class="feat" data-reveal="stagger" role="list">
{% set photo = shots[site.screenshots.index('07-before-after')] %}{% for feature in c.features %}<li{% if loop.index0 < 3 %} class="has-stage"{% endif %}>{% if loop.index0 == 0 %}{{ stage_sensors(photo, c.sensor_values) }}{% elif loop.index0 == 1 %}{{ stage_listen(photo) }}{% elif loop.index0 == 2 %}{{ stage_shot(photo) }}{% endif %}<span class="mono">{{ '%02d' | format(loop.index) }}</span><h3>{{ c.feature_titles[loop.index0] }}</h3><p>{{ feature }}</p></li>
{% endfor %}
</ul>
</div>
</section>

<section id="privacy" class="sec">
<div class="wrap">
<div class="priv">
<div class="sec-head flush">{{ marker(8) }}<h2>{{ t.privacy }}</h2>
{% for sentence in c.privacy_summary %}<p>{{ sentence }}</p>{% endfor %}
<p><a class="more" href="{{ route(lang, true) }}">{{ t.privacy_full }}</a></p>
</div>
<ul class="glance" data-reveal role="list" aria-label="{{ c.glance_label }}">
{% for g in c.glance %}<li><span>{{ g.key }}</span><span>{{ g.value }}</span></li>{% endfor %}
</ul>
</div>
<h3 class="path-title">{{ c.mic_title }}</h3>
<ol class="path" data-reveal="stagger" role="list">
{% for step in c.mic_steps %}<li><span class="mono step">{{ c.mic_step }} {{ loop.index }}</span><span class="cell" aria-hidden="true"></span><strong>{{ step.name }}</strong><span class="d">{{ step.text }}</span></li>
{% endfor %}
</ol>
</div>
</section>

<section id="support" class="sec">
<div class="wrap">
<div class="sec-head" data-reveal>{{ marker(9) }}<h2>{{ t.support }}</h2><p class="mono">{{ t.faq }}</p></div>
<div class="faq" data-reveal>
{% for item in c.faq %}<details{% if loop.first %} open{% endif %}><summary><span>{{ item.question }}</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><p>{{ item.answer }}</p></details>
{% endfor %}
</div>
<div class="mail" data-reveal>
<p><span class="mono">{{ c.mail_label }}</span><span class="big">{{ c.mail_text }} <a href="mailto:{{ contact_email }}">{{ contact_email }}</a></span></p>
<a class="btn out" href="{{ site.repo_url }}/issues">{{ c.issue_link }}</a>
</div>
</div>
</section>
{% endblock %}
