{% extends 'base/layout.html.j2' %}
{% from 'macros.html.j2' import marker %}
{% block content %}
<div class="page-intro">
<div class="wrap">
<a class="back mono" href="{{ route(lang) }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ t.home }}</a>
{{ marker(8) }}
<h1 class="glitch">{{ t.privacy_full }}</h1>
<p class="mono">{{ t.privacy_version }} <time datetime="{{ c.privacy_date }}">{{ c.privacy_date }}</time></p>
{% if policy_lang != lang %}<p class="privacy-fallback">{{ t.privacy_fallback.format(language=t.languages[policy_lang]) }}</p>{% endif %}
</div>
</div>
<div class="wrap">
<article class="policy" lang="{{ policy_lang }}">{{ policy_html }}</article>
</div>
{% endblock %}
