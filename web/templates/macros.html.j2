{#- Square-cell section marker, like the app's glitch loader: three lit cells out of twelve. -#}
{% macro marker(start) -%}
<span class="marker" aria-hidden="true">{% for i in range(12) %}<i{% if start <= i < start + 3 %} class="on"{% endif %}></i>{% endfor %}</span>
{%- endmacro %}

{#- Twelve square meter cells; `lit` of them on. -#}
{% macro cells(lit) -%}
<span class="cells" data-loop aria-hidden="true">{% for i in range(12) %}<i{% if i < lit %} class="on{% if i == lit - 1 %} end{% endif %}"{% elif i == lit %} class="nx"{% endif %}></i>{% endfor %}</span>
{%- endmacro %}

{#- The three sensor icons of the app's level legend (microphone, sun, four arrows). -#}
{% macro sensor_icon(kind, size=18) -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if kind == 'noise' %}<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>{% elif kind == 'light' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>{% else %}<path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20"/>{% endif %}</svg>
{%- endmacro %}

{#- The real photo of the app's Before/After screenshot (07), cropped by CSS to the picture area. Same file as the
    screenshot reel, so the browser fetches it once. Decorative: the stage is aria-hidden. -#}
{% macro ph(shot) -%}
<picture><source type="image/avif" srcset="{{ shot.avif }}" sizes="400px"><source type="image/webp" srcset="{{ shot.webp }}" sizes="400px"><img class="ph" src="{{ shot.src }}" srcset="{{ shot.webp }}" sizes="400px" width="{{ shot.width }}" height="{{ shot.height }}" alt="" loading="lazy" decoding="async"></picture>
{%- endmacro %}

{#- A meter: 12 unlit cells with the lit ones drawn over them, so the lit part can move with a clip. -#}
{% macro meter(kind, lit) -%}
<span class="mt {{ kind }}"><span class="mt-lit mt-{{ lit }}"></span></span>
{%- endmacro %}

{#- Stage 1, three sensors: the legend of the app over the photo; each reading takes a turn to bend the frame. -#}
{% macro stage_sensors(shot, values) -%}
<div class="stage st-sens" data-loop aria-hidden="true">
<div class="st-view"><div class="tilt">{{ ph(shot) }}{% for i in range(5) %}<span class="strip">{{ ph(shot) }}</span>{% endfor %}<i class="st-dim"></i><i class="st-glow"></i></div></div>
<div class="legend">
{% set kinds = ['noise', 'light', 'move'] %}{% set lits = [9, 4, 7] %}{% for k in kinds %}<div class="lg lg-{{ k }}">{{ sensor_icon(k, 14) }}{{ meter(k, lits[loop.index0]) }}<span class="val"><b>{{ values[loop.index0].value }}</b> {{ values[loop.index0].unit }}</span></div>
{% endfor %}</div>
</div>
{%- endmacro %}

{#- Stage 2, the photo listens: level bars and the picture sliding in horizontal bands to the beat. -#}
{% macro stage_listen(shot) -%}
<div class="stage st-listen" data-loop aria-hidden="true">
{{ ph(shot) }}{% for i in range(6) %}<span class="strip">{{ ph(shot) }}</span>{% endfor %}
<div class="bars">{% for i in range(20) %}<i></i>{% endfor %}</div>
</div>
{%- endmacro %}

{#- Stage 3, the shot: reticle, shutter, a freeze with a 2 px cyan and magenta double that settles, and the picture
    shrinking into the gallery strip. At rest (no motion) it shows the end: the picture already in the strip. -#}
{% macro stage_shot(shot) -%}
<div class="stage st-shot" data-loop aria-hidden="true">
<div class="live">{{ ph(shot) }}</div>
<span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
<div class="mic">{{ sensor_icon('noise', 12) }}{{ meter('noise', 9) }}</div>
<i class="ring"></i>
<div class="gal"><i></i><i></i><i></i><i></i></div>
<div class="snap"><div class="snap-in">{{ ph(shot) }}</div><i class="gh gc"></i><i class="gh gm"></i></div>
</div>
{%- endmacro %}
